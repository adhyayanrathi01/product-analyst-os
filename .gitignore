# Secrets. Never commit a value. CHARTER C-09: secrets are referred to by
# environment-variable name only.
.env
.env.*
!.env.example
secrets/
*.pem
*.key
id_rsa
id_rsa.pub
credentials.json
service-account*.json
gcloud-key*.json
.pgpass
.mongoshrc.js
.netrc

# Local credential caches written by CLIs.
.config/gcloud/
.supabase/
supabase/.temp/

# Your workspace. This repo is a public template, and these paths hold your
# company's data: your definitions, your captured schema, your reports, your
# task state and log. They stay on this machine. Each one is created from the
# tracked blank in a _template/ folder by ./setup.sh, which never overwrites.
#
# To version them, use a PRIVATE repo, never a public fork, and delete only the
# lines you mean to track. Commits touching knowledge-base/ then need
# PAOS_ALLOW_PROTECTED=1, on purpose.
/knowledge-base/*
!/knowledge-base/README.md
!/knowledge-base/_template/
/reports/*
!/reports/README.md
!/reports/_template/
/schema/*
!/schema/README.md
!/schema/_template/
/sources/sources.md
/task.md
/log.md

# Raw schema captures, anywhere. An introspection dump carries real table
# names, column names and column comments. Keep these out even if you opt
# schema/ in above. Only a reviewed schema/<source>/schema.md is worth keeping.
schema/**/raw/
schema/**/*.raw.json
schema/**/*.capture.json
schema/**/*.sample.json
*.introspect.json
*.catalog.json

# Query output and scratch data pulled from a source.
*.csv
*.tsv
*.parquet
*.ndjson
tmp/
.cache/
out/

# MCP client state that can contain tokens.
.mcp.local.json
.claude/settings.local.json
.codex/auth.json

# OS and editor cruft.
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
__pycache__/
*.pyc

# MCP config may contain a pasted literal token
.mcp.json

# Maintainer notes and the original design doc. Kept on this machine, not part of the template.
/docs/dev/
/docs/plans/
