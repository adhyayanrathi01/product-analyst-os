# Copy to .env and fill in. .env is gitignored, keep it that way.
# Names only in this file. Never commit a value (CHARTER C-09).
# Only fill the block for a source you actually connect. An unset variable for
# a source you skipped is fine, ./setup.sh --check reports it as not connected.

# ---------------------------------------------------------------------------
# PostHog (event)
# ---------------------------------------------------------------------------
# Personal API key, prefix phx_. Create at /settings/user-api-keys with the
# "MCP Server" preset. Minimum scopes: Query Read, event_definition:read,
# property_definition:read. No write scopes.
POSTHOG_API_KEY=
# Numeric project id. Sent as the x-posthog-project-id header so the key is
# scoped to one project.
POSTHOG_PROJECT_ID=
# API host for your region, for example https://us.posthog.com or
# https://eu.posthog.com. Used for REST calls, not for the MCP endpoint.
POSTHOG_HOST=
# Remote MCP endpoint. https://mcp.posthog.com/mcp
POSTHOG_MCP_URL=

# ---------------------------------------------------------------------------
# Mixpanel (event)
# ---------------------------------------------------------------------------
# Project id, used to scope every MCP tool call to one project.
MIXPANEL_PROJECT_ID=
# Region endpoint. https://mcp.mixpanel.com/mcp for US,
# https://mcp-eu.mixpanel.com/mcp for EU, https://mcp-in.mixpanel.com/mcp for IN.
MIXPANEL_MCP_URL=
# Service account username. Only needed if you use the Service Accounts path
# instead of OAuth. Service accounts for MCP are in beta.
MIXPANEL_SERVICE_ACCOUNT_USER=
# Service account secret. Read scopes only: projects, analysis, events,
# insights, segmentation, retention, data:read, funnels, flows, data_definitions.
MIXPANEL_SERVICE_ACCOUNT_SECRET=

# ---------------------------------------------------------------------------
# Amplitude (event)
# ---------------------------------------------------------------------------
# Remote MCP endpoint. https://mcp.amplitude.com/mcp for US,
# https://mcp.eu.amplitude.com/mcp for EU. MCP auth itself is OAuth 2.0, so
# there is no MCP token variable here.
AMPLITUDE_MCP_URL=
# Project API key. Used for HTTP Basic auth on the Taxonomy API, as the
# username half of api-key:secret-key.
AMPLITUDE_API_KEY=
# Project secret key. The password half of the same Basic auth pair. Read use
# only. The account holding it must sit in a Viewer-tier role, because every
# Amplitude role grants USE_MCP_READ and Member, Manager and Admin also grant
# USE_MCP_WRITE.
AMPLITUDE_SECRET_KEY=

# ---------------------------------------------------------------------------
# BigQuery (warehouse)
# ---------------------------------------------------------------------------
# GCP project id that owns the data and runs the query jobs.
BIGQUERY_PROJECT=
# Default dataset for introspection and smoke tests.
BIGQUERY_DATASET=
# Hard cost cap in bytes, applied to every query. 1000000000 is 1 GB. An
# unbounded scan is a spend, so this is not optional.
BIGQUERY_MAXIMUM_BYTES_BILLED=
# Path to the service account key file used for Application Default
# Credentials. The service account needs roles/bigquery.dataViewer and
# roles/bigquery.jobUser, never roles/bigquery.dataEditor. If you use
# `gcloud auth application-default login` instead, leave this unset.
GOOGLE_APPLICATION_CREDENTIALS=
# Path to the Google MCP Toolbox binary, for example ./toolbox.
TOOLBOX_BIN=

# ---------------------------------------------------------------------------
# Metabase (BI)
# ---------------------------------------------------------------------------
# Base URL of the instance, for example https://metabase.example.com.
METABASE_HOST=
# API key sent as the x-api-key header. Requires Metabase v0.47 or later.
# The key inherits the permissions of the group it is created in, so create it
# in a view-only group with no native query rights.
METABASE_API_KEY=
# Numeric database id inside Metabase, used by the metadata endpoint.
METABASE_DATABASE_ID=
# Built-in MCP endpoint, https://{host}/api/metabase-mcp. Requires AI features
# enabled on the instance. UNVERIFIED against any specific instance version,
# and no API-key config path is documented for it, OAuth only.
METABASE_MCP_URL=

# ---------------------------------------------------------------------------
# MongoDB (database)
# ---------------------------------------------------------------------------
# Connection string for a database user holding only the built-in `read` role
# on the target database. Name read by mongodb-mcp-server directly.
MDB_MCP_CONNECTION_STRING=
# Set to true. Second half of the read-only layer alongside the --readOnly flag.
MDB_MCP_READ_ONLY=
# Target database name, used by the introspection aggregation and the smoke test.
MONGODB_DATABASE=

# ---------------------------------------------------------------------------
# Postgres / Supabase (database)
# ---------------------------------------------------------------------------
# Connection URI for the dedicated read-only role, for example
# postgresql://agent_ro:...@host:5432/app. Name read by postgres-mcp directly.
# The GRANT set on agent_ro is the real boundary, not the URI.
DATABASE_URI=
# Supabase project ref, the subdomain in your project URL. Only for Supabase.
SUPABASE_PROJECT_REF=
# Supabase personal access token. Used with read_only=true on the remote MCP
# URL, which runs every query as a read-only Postgres user.
SUPABASE_ACCESS_TOKEN=
